<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="io.github.cechang256.xiaobu"
    android:versionCode="21"
    android:versionName="1.27">

    <uses-sdk android:minSdkVersion="29" android:targetSdkVersion="34" />

    <!-- Modern (libxposed) module: the framework recognises it by
         META-INF/xposed/java_init.list, and reads module.prop / scope.list from
         the same directory. No legacy xposed* meta-data here on purpose: with
         staticScope=true the scope cannot be widened in the manager. -->
    <application
        android:label="@string/app_name"
        android:description="@string/xposed_description"
        android:allowBackup="false"
        android:hasCode="true">

        <!-- Deliberately no launcher activity: the only entry point is the
             system editor (long-press the widget → 编辑默认样式). -->
        <provider
            android:name=".LayoutProvider"
            android:authorities="io.github.cechang256.xiaobu.layout"
            android:exported="true" />
    </application>
</manifest>
